# Copy relevant values into your Vercel project's Environment Variables
# (Project Settings -> Environment Variables). Never commit a real .env file.

# Required: Neon Postgres connection string. Without this the app falls back
# to an in-memory PGLite database (dev-only) and refuses to boot in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth stays off for this waitlist app. Leave as false unless you're
# deliberately turning on accounts/sign-in.
VITE_AUTH_ENABLED=false

# Only needed if VITE_AUTH_ENABLED is switched to true:
# BETTER_AUTH_SECRET=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
